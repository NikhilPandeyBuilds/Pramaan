APP_ENV=development
APP_NAME=NiyamAI
API_PREFIX=/api
FRONTEND_ORIGIN=http://localhost:5173

# Database configuration (defaults to SQLite for local development, or postgresql+psycopg://user:pass@localhost:5432/niyamai)
DATABASE_URL=sqlite:///./niyamai.db

SECRET_KEY=niyamai-sih-26261-secure-jwt-secret-key-32chars
SESSION_COOKIE_SECURE=false

STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage/uploads
MAX_UPLOAD_SIZE_MB=25

OCR_ENGINE=pymupdf_fallback
LLM_PROVIDER=none
EXTERNAL_VERIFICATION_MODE=synthetic

SEED_DEMO_DATA=true
